---
import { UI, type Locale } from '../i18n/ui';
import { LABELS } from '../i18n/labels';
import { CONTACT } from '../data/contact';
import InquiryForm from './InquiryForm.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = UI[locale];
const l = LABELS[locale];

const address = CONTACT.address[locale] ?? CONTACT.address.en;
const mapsQuery = encodeURIComponent(CONTACT.address.en);
const telHref = `tel:${CONTACT.phone.replace(/\s/g, '')}`;
const waNumber = CONTACT.whatsapp.replace(/[^0-9]/g, '');
const waHref = `https://wa.me/${waNumber}`;
const fbHref = `https://www.facebook.com/${CONTACT.facebook}`;
const websiteLabel = CONTACT.website.replace(/^https?:\/\//, '');

const btnStyle = 'margin-left:8px;font-size:0.78rem;padding:3px 10px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--muted);cursor:pointer;';
const rowStyle = 'display:flex;gap:12px;align-items:center;';
const iconStyle = 'width:22px;height:22px;flex-shrink:0;display:block;';
const linkStyle = 'color:var(--primary);font-weight:600;text-decoration:none;';
---

<div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:28px;display:grid;gap:18px;">
  <div style={rowStyle}>
    <svg viewBox="0 0 24 24" style={iconStyle} aria-hidden="true">
      <circle cx="12" cy="12" r="12" fill="var(--primary)"/>
      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z" fill="none" stroke="#fff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" transform="translate(12,12) scale(0.92) translate(-12,-12)"/>
    </svg>
    <div style="flex:1;">
      <a href={`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`} target="_blank" rel="noopener" style={linkStyle}>{address}</a>
      <div><button class="copy-btn" style={btnStyle} data-copy={address} data-copied={l.copied}>{l.copyAddress}</button></div>
    </div>
  </div>

  <div style={rowStyle}>
    <svg viewBox="0 0 24 24" style={iconStyle} aria-hidden="true">
      <circle cx="12" cy="12" r="12" fill="var(--primary)"/>
      <path d="M17,19H7V5H17M17,1H7C5.89,1 5,1.89 5,3V21A2,2 0 0,0 7,23H17A2,2 0 0,0 19,21V3C19,1.89 18.1,1 17,1Z" fill="#fff" transform="translate(12,12) scale(0.62) translate(-12,-12)"/>
    </svg>
    <a href={telHref} style={linkStyle}>{CONTACT.phone}</a>
    <button class="copy-btn" style={btnStyle} data-copy={CONTACT.phone} data-copied={l.copied}>{l.copy}</button>
  </div>

  <div style={rowStyle}>
    <svg viewBox="0 0 24 24" style={iconStyle} aria-hidden="true">
      <circle cx="12" cy="12" r="12" fill="var(--primary)"/>
      <g transform="translate(12,12) scale(0.92) translate(-12,-12)" fill="none" stroke="#fff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5.5" width="18" height="13" rx="2" vector-effect="non-scaling-stroke"/>
        <path d="M4 7.5l8 5.5 8-5.5" vector-effect="non-scaling-stroke"/>
      </g>
    </svg>
    <a href={`mailto:${CONTACT.email}`} style={linkStyle}>{CONTACT.email}</a>
    <button class="copy-btn" style={btnStyle} data-copy={CONTACT.email} data-copied={l.copied}>{l.copy}</button>
  </div>

  <div style={rowStyle}>
    <svg viewBox="0 0 24 24" style={iconStyle} aria-hidden="true">
      <circle cx="12" cy="12" r="12" fill="#25D366"/>
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" fill="#fff" transform="translate(12,12) scale(0.62) translate(-12,-12)"/>
    </svg>
    <a href={waHref} target="_blank" rel="noopener" style={linkStyle}>WhatsApp</a>
  </div>

  <div style={rowStyle}>
    <svg viewBox="0 0 24 24" style={iconStyle} aria-hidden="true">
      <circle cx="12" cy="12" r="12" fill="#07C160"/>
      <path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 0 1 .598.082l1.584.926a.272.272 0 0 0 .14.047c.134 0 .24-.111.24-.247 0-.06-.023-.12-.038-.177l-.327-1.233a.582.582 0 0 1-.023-.156.49.49 0 0 1 .201-.398C23.024 18.48 24 16.82 24 14.98c0-3.21-2.931-5.837-6.656-6.088V8.89c-.135-.01-.27-.027-.407-.03zm-2.53 3.274c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.97-.982zm4.844 0c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.969-.982z" fill="#fff" transform="translate(12,12) scale(0.62) translate(-12,-12)"/>
    </svg>
    <span>{l.wechat}: <b style="color:var(--primary-dark);">{CONTACT.wechat}</b></span>
    <button class="copy-btn" style={btnStyle} data-copy={CONTACT.wechat} data-copied={l.copied}>{l.copy}</button>
  </div>

  <div style={rowStyle}>
    <svg viewBox="0 0 24 24" style={iconStyle} aria-hidden="true">
      <circle cx="12" cy="12" r="12" fill="var(--primary)"/>
      <g transform="translate(12,12) scale(0.92) translate(-12,-12)" fill="none" stroke="#fff" stroke-width="1.0" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" vector-effect="non-scaling-stroke"/>
        <path d="M2 12h20" vector-effect="non-scaling-stroke"/>
        <ellipse cx="12" cy="12" rx="6.67" ry="10" vector-effect="non-scaling-stroke"/>
        <ellipse cx="12" cy="12" rx="3.33" ry="10" vector-effect="non-scaling-stroke"/>
        <path d="M3.34 7h17.32" vector-effect="non-scaling-stroke"/>
        <path d="M3.34 17h17.32" vector-effect="non-scaling-stroke"/>
      </g>
    </svg>
    <a href={CONTACT.website} target="_blank" rel="noopener" style={linkStyle}>{websiteLabel}</a>
  </div>

  <div style={rowStyle}>
    <svg viewBox="0 0 24 24" style={iconStyle} aria-hidden="true">
      <circle cx="12" cy="12" r="12" fill="#1877F2"/>
      <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z" fill="#fff" transform="translate(12,12) scale(0.62) translate(-12,-12)"/>
    </svg>
    <a href={fbHref} target="_blank" rel="noopener" style={linkStyle}>{CONTACT.facebookName}</a>
  </div>
</div>

<InquiryForm locale={locale} />

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy || '';
      try {
        await navigator.clipboard.writeText(text);
        const old = btn.textContent;
        btn.textContent = btn.dataset.copied || 'Copied';
        setTimeout(() => (btn.textContent = old), 1500);
      } catch (e) {
        /* clipboard not available */
      }
    });
  });
</script>
