---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { UI, type Locale, LOCALES } from '../../../i18n/ui';
import { LABELS } from '../../../i18n/labels';
import { pick } from '../../../i18n/util';
import { NEWS } from '../../../data/news';

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    NEWS.map((article) => ({
      params: { locale, slug: article.slug },
      props: { locale, article },
    }))
  );
}

const { locale, article } = Astro.props;
const t = UI[locale];
const L = LABELS[locale];
const n = pick(article.i18n, locale);
---
<BaseLayout locale={locale} title={n.title} description={n.excerpt} type="article">
  <section>
    <div class="container" style="max-width:760px;">
      <a href={`/${locale}/news`} style="color:var(--primary);font-weight:600;">← {L.allNews}</a>
      <div style="color:var(--muted);font-size:.85rem;margin-top:14px;">{article.date}</div>
      <h1 style="margin:6px 0 18px;color:var(--primary-dark);">{n.title}</h1>
      {n.body.map((b) => <p style="font-size:1.05rem;line-height:1.85;">{b.para}</p>)}
      <div style="margin-top:30px;">
        <a href={`/${locale}/contact`} class="btn">{L.inquiry}</a>
      </div>
    </div>
  </section>
</BaseLayout>
