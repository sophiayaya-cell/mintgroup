---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UI } from '../../i18n/ui';
const t = UI.ja;
---
<BaseLayout locale="ja" title="会社概要">
  <section style="padding:0;">
    <a class="hero-banner-link" href="/ja/contact/" aria-label="見積もりを依頼">
      <img
        src="/images/about-hero.webp"
        alt="淄博鵬旭の不織布製品"
        width="1920"
        height="1080"
        style="display:block;width:100%;height:auto;"
      />
    </a>
  </section>
  <section>
    <div class="container" style="max-width:760px;">
      <h2 class="section-title">{t.aboutTitle}</h2>
      <p style="color:var(--muted);font-size:1.05rem;text-align:center;">{t.aboutText}</p>
    </div>
  </section>
</BaseLayout>
