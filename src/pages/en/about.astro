---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UI } from '../../i18n/ui';
const t = UI.en;
---
<BaseLayout locale="en" title="About">
  <section style="padding:0;">
    <a class="hero-banner-link" href="/en/contact/" aria-label="Get a quote">
      <img
        src="/images/about-hero.webp"
        alt="Zibo Pengxu nonwoven fabric products"
        width="1920"
        height="1080"
        style="display:block;width:100%;height:auto;"
      />
    </a>
  </section>
  <section>
    <div class="container" style="max-width:760px;">
      <h2 class="section-title">{t.aboutTitle}</h2>
      <p style="color:var(--muted);font-size:1.05rem;text-align:center;">{t.aboutText}</p>
    </div>
  </section>
</BaseLayout>
