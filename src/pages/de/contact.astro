---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UI } from '../../i18n/ui';
const t = UI.de;
---
<BaseLayout locale="de" title="Kontakt">
  <section>
    <div class="container" style="max-width:620px;">
      <h2 class="section-title">{t.contactTitle}</h2>
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:28px;display:grid;gap:14px;">
        <p style="margin:0;">📍 {t.contactAddress}</p>
        <p style="margin:0;">✉️ {t.contactEmail}</p>
        <p style="margin:0;">📞 {t.contactPhone}</p>
      </div>
    </div>
  </section>
</BaseLayout>
